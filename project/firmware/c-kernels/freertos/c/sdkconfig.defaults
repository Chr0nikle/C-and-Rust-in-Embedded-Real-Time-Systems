# FreeRTOS benchmark configuration for ESP32-C6
# Based on ESP-IDF v5.5.5 defaults

# Target configuration
CONFIG_IDF_TARGET_ESP32C6=y

# FreeRTOS configuration
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=n
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=n

# USB-Serial-JTAG console (debug + protocol v1 on the C6 USB port)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
