diff --git a/firmware/Cargo.toml b/firmware/Cargo.toml
index 897e2449..c8f15e82 100644
--- a/firmware/Cargo.toml
+++ b/firmware/Cargo.toml
@@ -12,6 +12,7 @@ resolver = "2"
 # Board Rust firmware is `no_std`; panic=abort removes the need for
 # eh_personality and keeps the staticlib linkable into the C image.
 [profile.release]
+opt-level = 2
 panic = "abort"
 codegen-units = 1
 lto = true
diff --git a/firmware/c-kernels/freertos/c/main/CMakeLists.txt b/firmware/c-kernels/freertos/c/main/CMakeLists.txt
index e37eea27..a5d658a8 100644
--- a/firmware/c-kernels/freertos/c/main/CMakeLists.txt
+++ b/firmware/c-kernels/freertos/c/main/CMakeLists.txt
@@ -5,6 +5,8 @@ idf_component_register(SRCS "main.c"
                             "../../../../common/c/include"
                         REQUIRES log freertos esp_driver_usb_serial_jtag esp_timer esp_driver_gptimer)
 
+target_compile_options(${COMPONENT_LIB} PRIVATE "-O2" "-Wno-error=stringop-truncation")
+
 # Link the Rust application core (firmware/c-kernels/freertos/rust) instead of the shared C
 # runner. The rtos freertos plugin sets this for `--language rust`.
 option(BENCH_RUST "Link the Rust application core" OFF)
diff --git a/firmware/c-kernels/nuttx/c/CMakeLists.txt b/firmware/c-kernels/nuttx/c/CMakeLists.txt
index 811871c2..92f8cf89 100644
--- a/firmware/c-kernels/nuttx/c/CMakeLists.txt
+++ b/firmware/c-kernels/nuttx/c/CMakeLists.txt
@@ -94,4 +94,6 @@ if(CONFIG_EXAMPLES_RTOS_BENCH)
     8192
     PRIORITY
     100)
+
+  target_compile_options(apps_rtos_bench PRIVATE "-O2")
 endif()
diff --git a/firmware/c-kernels/zephyr/c/esp32c6/CMakeLists.txt b/firmware/c-kernels/zephyr/c/esp32c6/CMakeLists.txt
index 1aa33368..43dd2f26 100644
--- a/firmware/c-kernels/zephyr/c/esp32c6/CMakeLists.txt
+++ b/firmware/c-kernels/zephyr/c/esp32c6/CMakeLists.txt
@@ -17,6 +17,7 @@ if(NOT BENCH_RUST)
 endif()
 
 target_sources(app PRIVATE ${BENCH_SRC})
+set_source_files_properties(${BENCH_SRC} PROPERTIES COMPILE_OPTIONS "-O2")
 target_include_directories(app PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/../../../../common/c/include)
 
 if(BENCH_RUST)
