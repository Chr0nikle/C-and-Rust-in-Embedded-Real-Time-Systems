    },
    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/zephyr/c/stm32f4/port.c",
      "layer": "c_benchmark_rtos_adapter",
      "rationale": "STM32F4 Zephyr C benchmark adapter and port functions"
    },
    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/zephyr/c/stm32h723/port.c",
      "layer": "c_benchmark_rtos_adapter",
      "rationale": "STM32H723 Zephyr C benchmark adapter and port functions"
    },
    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/zephyr/c/nrf52840dk/port.c",
      "layer": "c_benchmark_rtos_adapter",
      "rationale": "nRF52840 Zephyr C benchmark adapter and port functions"
    },
    {
      "scope": "c-support",
      "path_prefix": "firmware/c-kernels/freertos/c/",
      "layer": "c_support_linked_with_rust",
      "rationale": "FreeRTOS C bridge, session and board support compiled into the Rust firmware"
    },
    {
      "scope": "c-support",
      "path_prefix": "firmware/c-kernels/nuttx/c/",
      "layer": "c_support_linked_with_rust",
      "rationale": "NuttX C bridge, session and interrupt support compiled into the Rust firmware"
    },
    {
      "scope": "c-support",
      "path_prefix": "firmware/c-kernels/zephyr/c/",
      "layer": "c_support_linked_with_rust",
      "rationale": "Zephyr C bridge, session and board support compiled into the Rust firmware"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/rust-kernels/freertos-in-rust/rust/src/arena.rs",
      "layer": "shared_infrastructure",
      "rationale": "portable arena implementation shared with the other benchmark paths"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/rust-kernels/freertos-in-rust/rust/src/",
      "layer": "rust_native_application",
      "rationale": "FreeRTOS-in-Rust benchmark application and Rust-native kernel integration"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/rust-kernels/rivet/rust/stm32f4/src/arena.rs",
