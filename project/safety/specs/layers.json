{
  "schema": "uastw-inventory-layers-v2",
  "default": "unclassified",
  "rules": [
    {
      "scope": "*",
      "path_prefix": ".local/",
      "layer": "external_component",
      "rationale": "third-party source staged outside the project tree"
    },
    {
      "scope": "*",
      "path_prefix": "firmware/rust-kernels/freertos-in-rust/rust/vendor/",
      "layer": "external_component",
      "rationale": "vendored FreeRTOS-in-Rust dependency, not project-written code"
    },
    {
      "scope": ["c-benchmark", "c-support"],
      "path_prefix": "firmware/common/c/",
      "layer": "shared_infrastructure",
      "rationale": "shared C runner, arena and protocol headers"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/common/rust/",
      "layer": "shared_infrastructure",
      "rationale": "shared Rust runner and arena implementation"
    },
    {
      "scope": ["c-benchmark", "c-support"],
      "path_prefix": "firmware/c-kernels/",
      "basename": "bench.h",
      "layer": "shared_infrastructure",
      "rationale": "shared benchmark protocol declarations"
    },
    {
      "scope": ["c-benchmark", "c-support"],
      "path_prefix": "firmware/c-kernels/",
      "basename": "FreeRTOSConfig.h",
      "layer": "shared_infrastructure",
      "rationale": "project FreeRTOS configuration shared by the C and Rust paths"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/c-kernels/freertos/rust/src/boundary.rs",
      "layer": "rust_ffi_boundary",
      "rationale": "FreeRTOS Rust adapter, foreign declarations and raw-pointer boundary"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/c-kernels/nuttx/rust/src/boundary.rs",
      "layer": "rust_ffi_boundary",
      "rationale": "NuttX Rust adapter, foreign declarations and raw-pointer boundary"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/c-kernels/zephyr/rust/src/boundary.rs",
      "layer": "rust_ffi_boundary",
      "rationale": "Zephyr Rust adapter, foreign declarations and raw-pointer boundary"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/c-kernels/freertos/rust/src/lib.rs",
      "layer": "benchmark_application",
      "rationale": "FreeRTOS Rust benchmark application"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/c-kernels/nuttx/rust/src/lib.rs",
      "layer": "benchmark_application",
      "rationale": "NuttX Rust benchmark application"
    },
    {
      "scope": "rust",
      "path_prefix": "firmware/c-kernels/zephyr/rust/src/lib.rs",
      "layer": "benchmark_application",
      "rationale": "Zephyr Rust benchmark application"
    },
    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/freertos/c/main/main.c",
      "layer": "benchmark_application",
      "rationale": "ESP32-C6 FreeRTOS C benchmark session"
    },
    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/freertos/c/stm32f4/src/main.c",
      "layer": "benchmark_application",
      "rationale": "STM32F4 FreeRTOS C benchmark session"
    },
    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/freertos/c/stm32h723/src/main.c",
      "layer": "benchmark_application",
      "rationale": "STM32H723 FreeRTOS C benchmark session"
    },
    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/freertos/c/nrf52840dk/src/main.c",
