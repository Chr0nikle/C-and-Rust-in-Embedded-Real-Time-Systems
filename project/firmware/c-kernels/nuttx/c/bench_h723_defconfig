#
# Bench defconfig for the STM32H723 (FK723M1-ZGT6 core board) RTOS benchmark
# session app. Based on boards/arm/stm32h7/nucleo-h723zg/configs/nsh/defconfig,
# but starts the benchmark application directly as the init task (no NSH) and
# uses a USART1 serial console on PA9 (TX) / PA10 (RX) -- the FK723M1-ZGT6
# board's debug-header UART, wired to a CP2102 USB-serial adapter at 115200 8N1.
#
# CONFIG_STANDARD_SERIAL is not set
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="nucleo-h723zg"
CONFIG_ARCH_BOARD_NUCLEO_H723ZG=y
CONFIG_ARCH_CHIP="stm32h7"
CONFIG_ARCH_CHIP_STM32=y
CONFIG_ARCH_CHIP_STM32H723ZG=y
CONFIG_ARCH_CHIP_STM32H7=y
CONFIG_ARCH_CHIP_STM32H7_CORTEXM7=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_PERF_EVENTS=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARMV7M_DCACHE=y
CONFIG_ARMV7M_DCACHE_WRITETHROUGH=y
CONFIG_ARMV7M_DTCM=y
CONFIG_ARMV7M_ICACHE=y
CONFIG_BOARD_LOOPSPERMSEC=66627
CONFIG_BUILTIN=y
CONFIG_EXAMPLES_RTOS_BENCH=y
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_INIT_ENTRYPOINT="rtos_bench_main"
CONFIG_INIT_STACKSIZE=4096
CONFIG_INTELHEX_BINARY=y
CONFIG_LINE_MAX=64
CONFIG_MM_REGIONS=4
CONFIG_MQ_MAXMSGSIZE=256
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_PREALLOC_TIMERS=4
CONFIG_RAM_SIZE=131072
CONFIG_RAM_START=0x24000000
CONFIG_RAW_BINARY=y
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_SERIAL_TERMIOS=y
CONFIG_STACK_COLORATION=y
CONFIG_START_DAY=6
CONFIG_START_MONTH=12
CONFIG_START_YEAR=2011
CONFIG_STM32_DTCMEXCLUDE=y
CONFIG_STM32_FLASH_OVERRIDE_G=y
CONFIG_STM32_SRAM4EXCLUDE=y
CONFIG_STM32_USART1=y
CONFIG_SYSTEM_NSH=y
CONFIG_USART1_SERIAL_CONSOLE=y
CONFIG_USART1_RXBUFSIZE=1024
CONFIG_USART1_TXBUFSIZE=1024
CONFIG_USEC_PER_TICK=1000
