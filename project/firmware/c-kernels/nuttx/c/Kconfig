#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_RTOS_BENCH
	tristate "RTOS benchmark session application"
	default n
	---help---
		Enable the RTOS benchmark session application. Implements UART
		protocol v1 over the console UART (USART2 on stm32f4discovery)
		and runs the shared timer/queue benchmark suite.

if EXAMPLES_RTOS_BENCH

config EXAMPLES_RTOS_BENCH_PROGNAME
	string "Program name"
	default "rtos_bench"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_RTOS_BENCH_PRIORITY
	int "RTOS bench task priority"
	default 100

config EXAMPLES_RTOS_BENCH_STACKSIZE
	int "RTOS bench stack size"
	default 8192

endif
