    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/nuttx/c/main.c",
      "layer": "benchmark_application",
      "rationale": "NuttX C benchmark session"
    },
    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/zephyr/c/esp32c6/main.c",
      "layer": "benchmark_application",
      "rationale": "ESP32-C6 Zephyr C benchmark session"
    },
    {
      "scope": "c-benchmark",
      "path_prefix": "firmware/c-kernels/zephyr/c/stm32f4/main.c",
