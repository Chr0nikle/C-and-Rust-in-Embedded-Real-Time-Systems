#
# Bench defconfig for the nRF52840 DK RTOS benchmark session app.
# Based on boards/arm/nrf52/nrf52840-dk/configs/nsh/defconfig, but starts the
# benchmark application directly as the init task (no NSH shell) and keeps the
# console on UART0 (P0.06 TX / P0.08 RX), exposed as the J-Link VCOM.
#
# CONFIG_ARCH_FPU is not set
# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_CMDOPT_HEXDUMP is not set
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="nrf52840-dk"
CONFIG_ARCH_BOARD_NRF52840_DK=y
CONFIG_ARCH_CHIP="nrf52"
CONFIG_ARCH_CHIP_NRF52840=y
CONFIG_ARCH_CHIP_NRF52=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_STDARG_H=y
CONFIG_BOARD_LOOPSPERMSEC=5500
CONFIG_BUILTIN=y
CONFIG_EXAMPLES_RTOS_BENCH=y
CONFIG_FS_PROCFS=y
CONFIG_INIT_ENTRYPOINT="rtos_bench_main"
CONFIG_INTELHEX_BINARY=y
CONFIG_LINE_MAX=64
CONFIG_MM_REGIONS=2
CONFIG_NRF52_UART0=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_PREALLOC_TIMERS=4
# Full 256 KB nRF52840 SRAM. The 65535 upstream default leaves g_idle_topstack
# (0x2001bcd4) above CONFIG_RAM_END (0x2000FFFF), underflowing the heap so
# mallinfo().fordblks is negative (case 24 BENCH_PORT; finding
# 20261003T152630Z-92f329124f2a).
CONFIG_RAM_SIZE=262144
CONFIG_RAM_START=0x20000000
CONFIG_RAW_BINARY=y
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_SERIAL_TERMIOS=y
CONFIG_STACK_COLORATION=y
CONFIG_START_DAY=26
CONFIG_START_MONTH=3
CONFIG_SYMTAB_ORDEREDBYNAME=y
CONFIG_SYSTEM_NSH=y
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_USEC_PER_TICK=1000
CONFIG_MQ_MAXMSGSIZE=256
